# FastAPI Backend Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # Required for administrative backend tasks and validation dataset management

# Validation Dataset Configuration (Development only)
TEST_USER_PASSWORD=your-secure-test-user-password        # Required for provisioning controlled @lokal.dev test accounts

# Google Places API Configuration
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

